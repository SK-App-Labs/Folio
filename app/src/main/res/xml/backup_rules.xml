<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude SQLite temporary journal, WAL, and SHM files to prevent corrupted restoration -->
    <exclude domain="database" path="folio_ledger.db-wal" />
    <exclude domain="database" path="folio_ledger.db-shm" />
    <exclude domain="database" path="folio_ledger.db-journal" />
    <exclude domain="database" path="folio_ledger.db.pre_migration_bak" />
    <exclude domain="database" path="folio_ledger.db.pre_migration_bak-wal" />
    <exclude domain="database" path="folio_ledger.db.pre_migration_bak-shm" />
    <exclude domain="database" path="folio_database-wal" />
    <exclude domain="database" path="folio_database-shm" />
    <exclude domain="database" path="folio_database-journal" />

    <!-- Exclude Demo Mode pre-demo stash so sensitive ledger files are not backed up -->
    <exclude domain="file" path="demo_stash" />
</full-backup-content>

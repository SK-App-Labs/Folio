<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude SQLite temporary journal, WAL, and SHM files to prevent corrupted restoration -->
        <exclude domain="database" path="folio_database-wal" />
        <exclude domain="database" path="folio_database-shm" />
        <exclude domain="database" path="folio_database-journal" />

        <!-- Exclude Demo Mode pre-demo stash -->
        <exclude domain="file" path="demo_stash" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude SQLite temporary journal, WAL, and SHM files to prevent corrupted restoration -->
        <exclude domain="database" path="folio_database-wal" />
        <exclude domain="database" path="folio_database-shm" />
        <exclude domain="database" path="folio_database-journal" />

        <!-- Exclude Demo Mode pre-demo stash -->
        <exclude domain="file" path="demo_stash" />
    </device-transfer>
</data-extraction-rules>
